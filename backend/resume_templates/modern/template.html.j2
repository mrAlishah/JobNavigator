<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} — Resume</title>

<style>
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 0;
}

html, body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 9.5pt;
  line-height: 1.3;
  color: #202124;
  background: #fff;
  -webkit-font-smoothing: antialiased;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 0.55in 0.6in;
  margin: 0 auto;
}

/* Header */

.header {
  border-bottom: 2px solid #202124;
  padding-bottom: 10pt;
  margin-bottom: 14pt;
}

.header h1 {
  font-size: 23pt;
  font-weight: 700;
  letter-spacing: -0.5px;
  color: #111;
  margin-bottom: 3pt;
}

.header .title-line {
  font-size: 10pt;
  color: #555;
  margin-bottom: 6pt;
}

.header .contact {
  font-size: 8.5pt;
  color: #444;
  line-height: 1.5;
}

.header .contact a {
  color: #444;
  text-decoration: none;
}

.header .contact .sep {
  margin: 0 5pt;
  color: #999;
}

/* Sections */

.section {
  margin-top: 13pt;
}

.section-title {
  font-size: 9pt;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.8px;
  color: #111;
  border-bottom: 1px solid #d0d0d0;
  padding-bottom: 3pt;
  margin-bottom: 6pt;
}

/* Summary */

.summary-text {
  font-size: 9.5pt;
  line-height: 1.35;
  color: #333;
}

/* Entries */

.entry {
  margin-bottom: 8pt;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10pt;
}

.entry-company {
  font-weight: 700;
  color: #111;
}

.entry-date {
  color: #555;
  text-align: right;
  white-space: nowrap;
  font-size: 8.5pt;
}

.entry-title {
  color: #444;
  font-size: 9pt;
}

.entry-location {
  color: #555;
  text-align: right;
  white-space: nowrap;
  font-size: 8.5pt;
}

.entry-description {
  color: #444;
  margin-top: 3pt;
  font-size: 9pt;
}

.entry-url {
  font-size: 8pt;
  margin-top: 2pt;
}

.entry-url a {
  color: #555;
  text-decoration: none;
}

/* Bullets */

ul.bullets {
  margin-left: 16pt;
  margin-top: 3pt;
}

ul.bullets li {
  margin-bottom: 2pt;
  font-size: 9pt;
  line-height: 1.3;
}

/* Skills */

.skill-line {
  margin-bottom: 3pt;
  line-height: 1.3;
}

.skill-label {
  font-weight: 700;
  color: #111;
}

/* Education */

.edu-entry {
  margin-bottom: 7pt;
}

.edu-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10pt;
}

.edu-school {
  font-weight: 700;
  color: #111;
}

.edu-location {
  color: #555;
  text-align: right;
  white-space: nowrap;
  font-size: 8.5pt;
}

.edu-degree {
  color: #444;
  font-size: 9pt;
  margin-top: 1pt;
}

/* Project / Publication */

.entry-name {
  font-weight: 700;
  color: #111;
}

/* Print */

@media print {
  .page {
    padding-bottom: 0;
  }

  .entry:last-child,
  .edu-entry:last-child,
  .skill-line:last-child {
    margin-bottom: 0;
  }

  .section-title {
    break-after: avoid;
  }
}
</style>
</head>

<body>

<div class="page">

  <!-- Header -->
  {% if header %}
  <div class="header">

    <h1>{{ header.name }}</h1>

    {% if header.title %}
    <div class="title-line">{{ header.title }}</div>
    {% endif %}

    <div class="contact">
      {% set contact_parts = [] %}

      {% for item in (header.contact_items or []) %}

        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          {% set _ = contact_parts.append('<a href="' ~ href ~ '">' ~ item.text ~ '</a>') %}

        {% else %}
          {% set _ = contact_parts.append(item.text) %}
        {% endif %}

      {% endfor %}

      {{ contact_parts | join('<span class="sep">|</span>') }}
    </div>

  </div>
  {% endif %}


  <!-- Summary -->
  {% if summary %}
  <div class="section">

    <div class="section-title">
      Summary
    </div>

    <div class="summary-text">
      {{ summary }}
    </div>

  </div>
  {% endif %}


  <!-- Experience -->
  {% if experience %}
  <div class="section">

    <div class="section-title">
      Experience
    </div>

    {% for job in experience %}

    <div class="entry">

      <div class="entry-row">
        <span class="entry-company">
          {{ job.company }}
        </span>

        <span class="entry-date">
          {{ job.date }}
        </span>
      </div>

      <div class="entry-row">

        <span class="entry-title">
          {{ job.title }}
        </span>

        <span class="entry-location">
          {{ job.location }}
        </span>

      </div>

      {% if job.description %}
      <div class="entry-description">
        {{ job.description }}
      </div>
      {% endif %}

      {% if job.bullets %}
      <ul class="bullets">

        {% for bullet in job.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}

      </ul>
      {% endif %}

    </div>

    {% endfor %}

  </div>
  {% endif %}


  <!-- Skills -->
  {% if skills %}
  <div class="section">

    <div class="section-title">
      Skills
    </div>

    {% for label, value in skills.items() %}

    <div class="skill-line">
      <span class="skill-label">{{ label }}:</span>
      {{ value }}
    </div>

    {% endfor %}

  </div>
  {% endif %}


  <!-- Education -->
  {% if education %}
  <div class="section">

    <div class="section-title">
      Education
    </div>

    {% for edu in education %}

    <div class="edu-entry">

      <div class="edu-row">

        <span class="edu-school">
          {{ edu.school }}
        </span>

        <span class="edu-location">
          {{ edu.location }}
        </span>

      </div>

      {% if edu.degree %}
      <div class="edu-degree">
        {{ edu.degree }}
      </div>
      {% endif %}

    </div>

    {% endfor %}

  </div>
  {% endif %}


  <!-- Projects -->
  {% if projects %}
  <div class="section">

    <div class="section-title">
      Projects
    </div>

    {% for project in projects %}

    <div class="entry">

      <div class="entry-name">
        {{ project.name or project.title }}
      </div>

      {% if project.url %}
      <div class="entry-url">
        <a href="{{ project.url }}">
          {{ project.url }}
        </a>
      </div>
      {% endif %}

      {% if project.description %}
      <div class="entry-description">
        {{ project.description }}
      </div>
      {% endif %}

      {% if project.bullets %}
      <ul class="bullets">

        {% for bullet in project.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}

      </ul>
      {% endif %}

    </div>

    {% endfor %}

  </div>
  {% endif %}


  <!-- Publications -->
  {% if publications %}
  <div class="section">

    <div class="section-title">
      Publications
    </div>

    {% for pub in publications %}

    <div class="entry">

      <div class="entry-name">
        {{ pub.name or pub.title }}
      </div>

      {% if pub.description %}
      <div class="entry-description">
        {{ pub.description }}
      </div>
      {% endif %}

      {% if pub.bullets %}
      <ul class="bullets">

        {% for bullet in pub.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}

      </ul>
      {% endif %}

    </div>

    {% endfor %}

  </div>
  {% endif %}

</div>

</body>
</html>
